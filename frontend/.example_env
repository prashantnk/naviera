# frontend/.env.example

# --- Supabase Configuration ---
# You can find these in your Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-api-key"

# --- Backend Configuration ---
# Leave blank for local development. Set this to your Render URL in Vercel!
# BACKEND_API_URL="https://naviera-backend.onrender.com"

# --- Cache Revalidation Configuration ---
REVALIDATION_SECRET="naviera-revalidation-secret-key"

REACT_EDITOR=atom
RUST_BACKTRACE=1