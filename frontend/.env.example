# Naviera frontend environment: copy to frontend/.env.local and fill in real values.
# Never commit the real .env.local. Every value below is a placeholder.
# These four keys are every `process.env.*` read by frontend/src and next.config.ts.

# Supabase project (public, safe for the browser). NEXT_PUBLIC_* values are inlined at
# `npm run build` time, so a change needs a rebuild/redeploy on Vercel.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<supabase-anon-key>

# Where Next.js proxies /api and /health (the FastAPI backend). Server-side only.
# Defaults to http://127.0.0.1:8000 when unset (local dev).
BACKEND_API_URL=http://localhost:8000

# Shared secret for server-to-server cache revalidation (POST /api/revalidate with
# header x-revalidation-secret). Browser callers use the admin's JWT instead.
REVALIDATION_SECRET=<long-random-string>

# Optional comma-separated custom domain -> tenant slug mappings for middleware.ts
# (e.g. logismart.in:logismart,www.logismart.in:logismart).
# CUSTOM_DOMAIN_TENANTS=logismart.in:logismart,www.logismart.in:logismart
