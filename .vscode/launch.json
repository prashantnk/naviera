{
  // Run and Debug configurations (F5).
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend: FastAPI (debug)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload", "--reload-dir", "app"],
      "cwd": "${workspaceFolder}/backend",
      "python": "${workspaceFolder}/backend/.venv/bin/python",
      "env": { "PYTHON_KEYRING_BACKEND": "keyring.backends.null.Keyring" },
      "jinja": true,
      "justMyCode": true
    },
    {
      "name": "Backend: Pytest (current file)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["${file}", "-v"],
      "cwd": "${workspaceFolder}/backend",
      "python": "${workspaceFolder}/backend/.venv/bin/python",
      "env": { "PYTHON_KEYRING_BACKEND": "keyring.backends.null.Keyring" }
    },
    {
      "name": "Frontend: Next.js (server-side debug)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev -- -p 3000",
      "cwd": "${workspaceFolder}/frontend"
    }
  ]
}
