# Naviera backend environment: copy to backend/.env and fill in real values.
# Never commit the real .env. Every value below is a placeholder.
#
# IMPORTANT: app/core/config.py `Settings` (pydantic-settings) REJECTS unknown keys in
# backend/.env ("Extra inputs are not permitted"), so the API, alembic and every script fail
# to start if you add a key that is not a `Settings` field. Test/tooling variables are listed
# at the bottom as shell exports only; keep them commented out in this file.

# --- Database (Supabase Postgres through PgBouncer, port 6543) ---
# Runtime connection used by FastAPI (asyncpg driver). URL-encode special characters in the
# password (e.g. `$` -> `%24`). app/core/db.py always uses NullPool + per-statement UUID names.
DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<url-encoded-password>@aws-1-us-east-1.pooler.supabase.com:6543/postgres
# Connection used by Alembic migrations (required: the API refuses to start without it).
# Can be the same URL as DATABASE_URL.
ALEMBIC_DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<url-encoded-password>@aws-1-us-east-1.pooler.supabase.com:6543/postgres
# Log every SQL statement (local debugging only; keep False in production).
DB_ECHO_LOG=False
CONSOLE_LOG=False

# --- Authentication ---
# Must equal the Supabase project's JWT secret (the backend verifies Supabase JWTs with it).
SECRET_KEY=<supabase-jwt-secret>
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Supabase ---
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<supabase-anon-key>
JWT_ISSUER=https://<project-ref>.supabase.co/auth/v1

# local | staging | production
ENVIRONMENT=local

# --- Optional (defaults shown; override only if needed) ---
# PROJECT_NAME=Naviera API
# API_V1_STR=/api/v1
# DOCS_ENDPOINT=/docs
# Logfire telemetry token; empty disables it.
LOGFIRE_TOKEN=

# --- Delhivery B2C live pricing (DESIGN.md v4 D0/D2; live tenant only) ---
# Server-only API token from one.delhivery.com (Settings -> API Setup).
# DELHIVERY_B2C_TOKEN=
# DELHIVERY_B2C_BASE_URL=https://track.delhivery.com
# The ONLY tenant UUID allowed to call the live Delhivery token (bound to `logismart`).
# DELHIVERY_TENANT_ID=

# --- Delhivery B2B Cargo / LTL live pricing (live tenant only; reuses DELHIVERY_TENANT_ID) ---
# API user of the "B2B Surface" account (registered account name without spaces, e.g.
# LOGISMARTB2BC). The password is the LTL API password, NOT the one.delhivery.com login;
# it comes from Delhivery (POST /forgot-password) and expires every 180 days.
# Empty username or password = the Delhivery B2B option shows "price unavailable".
# DELHIVERY_B2B_USERNAME=
# DELHIVERY_B2B_PASSWORD=
# DELHIVERY_B2B_BASE_URL=https://ltl-clients-api.delhivery.com

# =============================================================================
# SHELL-ONLY variables (NOT Settings fields). Export them in your shell or CI job;
# do NOT uncomment them here or the app fails with "Extra inputs are not permitted".
# =============================================================================
# Golden test tenant. Only slugs in scripts/tenant_data_core.py ALLOWED_TEST_SLUGS are accepted.
# export GOLDEN_TENANT_SLUG=logismart-test
# Password of the seeded @logismart.in test accounts (seed --execute, UI golden logins,
# scripts/run_golden.sh). Keep it in a password manager, never in a tracked file.
# export GOLDEN_TEST_PASSWORD=<test-accounts-password>
# UI golden layer (backend/scripts/tests/ui_golden/ui_config.py); defaults shown.
# export UI_CDP_URL=http://127.0.0.1:9224
# export UI_FRONTEND_URL=http://localhost:3000
# export UI_API_URL=http://localhost:8000
# export UI_SLOW_MO_MS=300
# export UI_HIGHLIGHT_MS=450
# Property-test example count (scripts/tests/test_money_properties.py).
# export PROPERTY_MAX_EXAMPLES=6
# Poetry on Cloudtop/gLinux without a desktop keyring.
# export PYTHON_KEYRING_BACKEND=keyring.backends.null.Keyring
