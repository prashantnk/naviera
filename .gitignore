# Dependencies / build output
node_modules/
.next/
dist/
*.tsbuildinfo

# Python / Backend
__pycache__/
*.py[cod]
.venv/
*.egg-info/
__pypackages__/
*.db
*.sqlite3

# Tool caches
.pytest_cache/
.ruff_cache/
.hypothesis/
coverage/

# Env files (only the committed *.example templates are tracked)
.env
.env.*
!.env.example

# IDE / Editor / OS (.vscode/ is shared on purpose)
.idea/
.DS_Store
Thumbs.db

# Agent and test scratch: temporary scripts, logs, patches and screenshots go ONLY under
# llm_resources/.agents/ (see AGENTS.md). Stray files elsewhere stay visible in `git status`.
llm_resources/
*.log
*.orig
*.rej

# Next.js 16 auto-generated agent pointer files
frontend/AGENTS.md
frontend/CLAUDE.md

# Agent Directives, Knowledge & Repo-Scoped Skills (personal rules, TASKS.md, and local reports stay ignored)
.agents/*
!.agents/AGENTS.md
!.agents/knowledge/
!.agents/knowledge/**
!.agents/skills/
!.agents/skills/**
